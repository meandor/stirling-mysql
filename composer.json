{
  "name": "meandor/stirling-mysql",
  "description": "A MySQL wrapper for the sterling-microservice",
  "type": "library",
  "homepage": "https://github.com/meandor/stirling-mysql",
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Schruhl",
      "email": "danielschruhl@gmail.com",
      "role": "Developer"
    }
  ],
  "version": "0.2.2",
  "require": {
    "php": ">=8.4",
    "meandor/stirling-microservice": "*",
    "ext-mysqli": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "infection/infection": "^0.35.8",
    "phpmd/phpmd": "^3.0"

  },
  "autoload": {
    "psr-4": {
      "StirlingMySQL\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
